# Runtime image for projects generated by bolt.diy.
# The bolt.diy app image (Dockerfile at the repo root) does not run those
# projects. They normally execute in the browser via WebContainer. This image
# runs an exported or mounted project on Linux.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    HOST=0.0.0.0 \
    HOSTNAME=0.0.0.0 \
    PORT=5173 \
    PROJECT_DIR=/workspace \
    INSTALL=auto

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      python3 \
      make \
      g++ \
      unzip \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@9.15.9 --activate \
    && corepack prepare yarn@1.22.22 --activate

WORKDIR /workspace

COPY package.json run-plan.js entrypoint.js /usr/local/lib/bolt-project/

EXPOSE 5173

LABEL org.opencontainers.image.title="bolt-project" \
      org.opencontainers.image.description="Runtime image for projects generated by bolt.diy"

ENTRYPOINT ["node", "/usr/local/lib/bolt-project/entrypoint.js"]
CMD ["dev"]
